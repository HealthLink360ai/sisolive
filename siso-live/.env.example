# ================================================
# SISO Live! Environment Configuration
# Copy this to .env and fill in your values
# NEVER commit .env to version control
# ================================================

# --- ANTHROPIC (Claude API) ---
# Decision: Claude 3.5 Sonnet — best accuracy/cost ratio
# Cost: ~$3-40/month at expected utilization
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- PINECONE (Vector Database) ---
# Decision: Managed vector DB — HIPAA-ready, free tier to start
# Cost: $0 until 1M vectors, ~$0.07/100k after
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=siso-live-prod
PINECONE_ENVIRONMENT=us-east-1-aws

# --- COHERE (Embedding Model) ---
# Decision: Pre-trained embeddings — no fine-tuning cost
# Cost: ~$0.10 per million tokens
COHERE_API_KEY=your_cohere_api_key_here
COHERE_EMBED_MODEL=embed-english-v3.0

# --- POSTGRESQL (Metadata + Audit Logs) ---
# Decision: Relational DB for compliance audit trails
# Cost: ~$20/month on managed Supabase or RDS
DATABASE_URL=postgresql://user:password@host:5432/siso_live
DATABASE_POOL_SIZE=5

# --- REDIS (Caching + Job Queue) ---
# Decision: Cache common queries, async doc processing
# Cost: ~$8/month on Upstash or Redis Cloud
REDIS_URL=redis://localhost:6379

# --- AUTHENTICATION ---
# Decision: JWT — stateless, works with serverless
JWT_SECRET=change_this_to_a_random_32_char_string_minimum
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# --- SPENDING CONTROLS ---
# Decision: Hard caps — no surprise bills for AbbVie
MONTHLY_BUDGET_CAP_USD=100
DAILY_QUERY_LIMIT_PER_USER=50
MAX_QUERIES_PER_MINUTE=10

# --- RAG CONFIGURATION ---
# Decision: 512-token chunks, 50-token overlap sweet spot
CONFIDENCE_THRESHOLD=0.90
MAX_CHUNKS_TO_RETRIEVE=5
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=50
MAX_ANSWER_CHARS=400
CACHE_TTL_SECONDS=86400

# --- APP ---
NODE_ENV=development
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000,https://sisolive.abbvie.com
